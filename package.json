{
  "name": "@umporg/config",
  "version": "0.3.1",
  "description": "Configurações partilhadas do UMP: preset Renovate, tsconfig, oxlint, oxfmt, presets JS para Vite+ (./vite), knip e versões-alvo alinhadas.",
  "license": "UNLICENSED",
  "files": [
    "default.json",
    "renovate",
    "tsconfig",
    "oxlint",
    "oxfmt",
    "vite",
    "knip",
    "versoes.json",
    ".nvmrc",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./versoes.json": "./versoes.json",
    "./vite": {
      "types": "./vite/index.d.ts",
      "default": "./vite/index.js"
    },
    "./tsconfig/*": "./tsconfig/*",
    "./oxlint/*": "./oxlint/*",
    "./oxfmt/*": "./oxfmt/*",
    "./knip/*": "./knip/*",
    "./renovate/*": "./renovate/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "validar": "node scripts/validar.mjs",
    "hooks": "node scripts/preparar.mjs"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "secretlint": "13.0.7"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@12.11.2"
}
