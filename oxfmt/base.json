{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "out/**",
    "coverage/**",
    "node_modules/**",
    "drizzle/meta/**",
    "playwright-report/**",
    "test-results/**",
    "**/*.md"
  ]
}
